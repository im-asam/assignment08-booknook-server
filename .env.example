# MongoDB Atlas connection string (database: booknook)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/booknook

# Shared secret used to sign/verify BetterAuth JWTs.
# MUST match the client's BETTER_AUTH_SECRET exactly, or verifyToken will 401.
BETTER_AUTH_SECRET=your-shared-secret-here

# Port the server listens on locally (default 5000)
PORT=5000

# Client origin allowed by CORS (e.g. https://booknook-client.vercel.app).
# If unset, all origins are allowed (dev only).
CLIENT_URL=
